  "types": [
    {"id":"balanced","label":"平和质","description":"关注精力、疲劳、情绪及适应冷热的整体表现；需要同时参考其他八类分数。"},
    {"id":"qi_deficiency","label":"气虚质","description":"关注容易疲劳、气短和心慌等长期自述表现。"},
    {"id":"yang_deficiency","label":"阳虚质","description":"关注局部怕冷、穿衣保暖和对寒冷的耐受表现。"},
    {"id":"yin_deficiency","label":"阴虚质","description":"关注身体发热感、干燥和面颊偏红等表现。"},
    {"id":"phlegm_damp","label":"痰湿质","description":"关注身体沉重、腹部形态及口内黏腻等表现。"},
    {"id":"damp_heat","label":"湿热质","description":"关注皮肤油腻、排尿和适用的局部表现。"},
    {"id":"blood_stasis","label":"血瘀质","description":"关注疼痛、肤色及唇色等表现；这些描述本身不能解释症状的原因。"},
    {"id":"qi_stagnation","label":"气郁质","description":"关注情绪低落、紧张和情感敏感等长期表现。"},
    {"id":"special","label":"特禀质","description":"关注既往过敏、喷嚏和皮肤反应；只回顾已有体验，不主动诱发反应。"}
  ],
  "options": [
    {"value":1,"label":"没有（根本不）"},
    {"value":2,"label":"很少（有一点）"},
    {"value":3,"label":"有时（有些）"},
    {"value":4,"label":"经常（相当）"},
    {"value":5,"label":"总是（非常）"}
