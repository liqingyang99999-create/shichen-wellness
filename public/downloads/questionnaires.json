  "simplified": {
    "title":"9题生活倾向简测",
    "method":"项目设计的9题倾向提示，未经量表验证",
    "note":"回顾近一年的通常体验。每类仅问一个代表性表现，分数只反映这次回答的频率，不是标准体质分数或诊断；多个倾向可以同时出现。想进一步了解可完成标准框架版。",
    "recallPeriod":"近一年",
    "validated":false,
    "scoreMeaning":"单项自述频率指数，0至100；不是概率，不套用国家标准判定阈值",
    "thresholds":{"prominentFrequency":75,"balancedFrequency":75,"otherMaximumForBalanced":25},
    "items":[
      {"id":"S01","text":"通常觉得精力足够、做日常事情有精神吗？","type":"balanced"},
      {"id":"S02","text":"日常活动中很容易觉得疲累吗？","type":"qi_deficiency"},
      {"id":"S03","text":"在别人觉得合适的温度下，自己仍明显怕冷吗？","type":"yang_deficiency"},
      {"id":"S04","text":"皮肤或嘴唇容易觉得干吗？","type":"yin_deficiency"},
      {"id":"S05","text":"常觉得身体沉甸甸、不够轻松吗？","type":"phlegm_damp"},
      {"id":"S06","text":"面部或鼻子容易出现明显油光吗？","type":"damp_heat"},
      {"id":"S07","text":"平时观察到自己的唇色偏暗吗？","type":"blood_stasis"},
      {"id":"S08","text":"容易感到紧张、焦虑或不安吗？","type":"qi_stagnation"},
      {"id":"S09","text":"以前容易因食物、药物、花粉等出现过敏反应吗？","type":"special"}
    ]
  },
  "standard": {
    "title":"现行标准框架版",
    "method":"依据GB/T 46939—2025附录A及第5章，题意简述版",
