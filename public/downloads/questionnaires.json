    "validatedAdaptation":false,
    "sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=827D6D266BA52A2983F93638DA871028",
    "sourceSections":"第5章；附录A表A.1—A.9（正文第6—9页）",
    "storedItemCount":27,
