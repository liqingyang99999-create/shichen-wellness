{
  "compilerOptions": {
    "target":"ES2022", "lib":["ES2022","DOM","DOM.Iterable"], "module":"ESNext", "moduleResolution":"Bundler",
    "jsx":"react-jsx", "strict":true, "noEmit":true, "skipLibCheck":true, "allowJs":true,
    "esModuleInterop":true, "resolveJsonModule":true, "isolatedModules":true,
    "types":["vite/client","node","@cloudflare/workers-types"]
  },
  "include":["src","worker","vite.config.ts"],
  "exclude":["node_modules","dist",".wrangler"]
}
