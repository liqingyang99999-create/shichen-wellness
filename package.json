{
  "name": "shichen-wellness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "时辰心管家：面向健康成年人的时辰节气日常行动与可解释 AI 编排演示",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "audit:coverage": "node test/coverage-audit.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf:login": "wrangler login",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "deploy:pages": "npm run build:pages && node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
